# DubRoom configuration — generated by scripts/setup.sh into /opt/dubroom/.env (mode 600).
# Never commit the real file.

DOMAIN=example.com
PLAY_HOST=play.example.com
STUDIO_HOST=studio.example.com
PUBLIC_URL=https://play.example.com
STUDIO_URL=https://studio.example.com
# WebSocket Origin allow-list (comma separated); empty = any (only for quick tunnels)
ALLOWED_ORIGINS=https://play.example.com

# Tunnel: token (A) | local (B) | quick (C)
TUNNEL_MODE=token
TUNNEL_TOKEN=
TUNNEL_COMMAND=tunnel --no-autoupdate --metrics 0.0.0.0:2000 run
TUNNEL_REPLICAS=2
CLOUDFLARED_VERSION=2025.9.1
# http2 (TCP, works almost everywhere) | quic (UDP) | auto
TUNNEL_PROTOCOL=http2

# Secrets — generated with openssl rand; rotate with scripts/rotate-secrets.sh
# TOKEN_SIGNING_KEY may hold several comma-separated keys: the first signs, all verify.
TOKEN_SIGNING_KEY=
STUDIO_KEY=

# Cloudflare Access for Clip Studio (recommended): team domain and application AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Paths and images
DATA_DIR=/opt/dubroom/data
DUBROOM_VERSION=0.2.8
DUBROOM_IMAGE=dubroom/app
DUBROOM_CADDY_IMAGE=dubroom/caddy

# Limits
# longest clip after trimming (long clips are played by scenes or streamed whole, ADR-0009)
CLIP_MAX_MINUTES=180
# absolute cap for one recorded take; the per-clip limit grows with the clip length
DUB_MAX_MB=64
MAX_ROOMS=500
DRAIN_SECONDS=300
JOB_TIMEOUT_MIN=10
WORKER_CPUS=2.0

# Backups (optional external S3-compatible target, age recipient for encryption)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_AGE_RECIPIENT=
BACKUP_S3_URL=

# Notifications from status.sh --notify (optional)
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
NOTIFY_EMAIL=
